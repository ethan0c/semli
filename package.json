{
  "name": "semli",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "eval:extract": "vite-node --config vitest.config.ts --script evals/run.ts",
    "eval:download": "vite-node --config vitest.config.ts --script evals/download.ts",
    "eval:typecheck": "tsc --noEmit -p evals/tsconfig.json",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev --workspace web",
    "dev:mobile": "npm run start --workspace mobile",
    "email": "node emails/cli.mjs",
    "store:changes": "node apps/mobile/scripts/store-notes.mjs changes",
    "store:check": "node apps/mobile/scripts/store-notes.mjs check"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite-node": "3.2.4",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "overrides": {
    "zod": "$zod"
  }
}
