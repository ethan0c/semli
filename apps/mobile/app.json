{
  "expo": {
    "name": "Semli",
    "slug": "semli",
    "version": "1.1.3",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/629299e1-defe-46c5-8110-0b0e9c787ffc"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "semli",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.semli.mobile",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Semli uses the camera to read printed schedules.",
        "NSPhotoLibraryUsageDescription": "Semli reads screenshots of schedules and syllabi you choose.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAlarmKitUsageDescription": "Semli rings alarms at the time of events and to-dos you mark urgent."
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon-light.png",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/splash-icon-light.png"
          },
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Semli reads screenshots of schedules and syllabi you choose.",
          "cameraPermission": "Semli uses the camera to read printed schedules."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Semli shows the events on your calendars beside your classes and shifts, so you can see what overlaps. They stay on your iPhone.",
          "remindersPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "es"]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "semli",
          "project": "semli-mobile"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Semli uses photo access to show recent screenshots for schedule imports.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Semli uses the microphone to transcribe events and tasks you dictate.",
          "speechRecognitionPermission": "Semli turns what you say into text on this phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "inlineModules": {
        "watchedDirectories": [
          "src/native"
        ]
      }
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "629299e1-defe-46c5-8110-0b0e9c787ffc"
      }
    },
    "owner": "ethanlma"
  }
}
